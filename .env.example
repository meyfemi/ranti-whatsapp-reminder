# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
# whatsapp | cli
ADAPTER=whatsapp
DATABASE_URL=postgres://ranti:ranti@localhost:5433/ranti
# Used only by the test suite.
TEST_DATABASE_URL=postgres://ranti:ranti@localhost:5433/ranti_test

# --- Bot identity / defaults ---
BOT_NAME=Ranti
DEFAULT_TIMEZONE=Africa/Lagos
MAX_ACTIVE_REMINDERS_PER_GROUP=50
BULK_IMPORT_MAX_ENTRIES=100

# --- Parser (Anthropic) ---
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-haiku-5-5
# Set to 1 to generate birthday/anniversary greetings with the LLM instead of templates.
LLM_GREETINGS=0

# --- WhatsApp (Baileys) ---
# Name of the auth session stored in Postgres (lets you run several numbers against one DB).
WA_SESSION_NAME=default
# Set to log in with a pairing code instead of a QR code (digits only, with country code).
WA_PAIRING_PHONE=
# Outgoing rate limits.
RATE_LIMIT_GLOBAL_PER_MINUTE=20
RATE_LIMIT_GROUP_PER_MINUTE=6
# Max messages to the bot handled per group per minute (protects against mention spam / LLM cost).
INBOUND_PER_GROUP_PER_MINUTE=10
REPLY_DELAY_MIN_MS=1000
REPLY_DELAY_MAX_MS=4000

# --- Ops ---
# Optional webhook that receives {"text": "..."} when the bot is logged out or needs attention.
ALERT_WEBHOOK_URL=
HEALTH_PORT=8080
